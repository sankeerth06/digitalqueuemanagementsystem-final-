NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (or local mongodb://127.0.0.1:27017/qserve)
MONGO_URI=mongodb+srv://qserveadmin:qserveadmin@cluster0.tfmbx4v.mongodb.net/qserve?retryWrites=true&w=majority&appName=Cluster0

# Generate strong random secrets for production, e.g. `openssl rand -hex 64`
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Frontend origin allowed for CORS + cookies
CLIENT_URL=http://localhost:5173

BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOG_LEVEL=info
